# Host-side environment for the LIVE DEMO — copy into your host's env UI.
# NEVER put SOLANA_PRIVATE_KEY or client-keypair.json here: the server never signs anything.

# TinyFish Search + Fetch — https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
# Groq (primary LLM) — https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (fallback LLM) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Oracle operator wallet (public key) — receives escrow claims
SOLANA_PAY_TO=6UBWeY293oqa98E5chTJcjZdqwqJL4Y93o56gep2HBMy

# Anchor escrow program (Devnet)
ESCROW_PROGRAM_ID=He1b6VfhTpSzbGpSSL6jDq6TicPqP4WkvQ4xSMPkdy9a

# Demo dUSD mint (self-minted on devnet). Omit to use Circle devnet USDC.
USDC_MINT=BUMDmMChHnBuzE7yzVegoojKDgz383zMwNAxb3Lgd8uc

X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_PRICE_USD=0.01
ALLOWED_DOMAINS=bbc.com,espn.com,reuters.com,apnews.com

# Host-assigned; the Express app binds to it automatically
# PORT=4021
